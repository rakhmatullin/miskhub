{
  "manifest_version": 3,
  "name": "Экзон — надстройка",
  "version": "0.5.0",
  "description": "Скачивает реестр замечаний Экзона в XLS и сохраняет HTML-копии рабочих страниц.",
  "action": {
    "default_title": "Надстройка Экзона"
  },
  "content_scripts": [
    {
      "matches": [
        "https://exon.exonproject.ru/*"
      ],
      "exclude_matches": [
        "https://exon.exonproject.ru/auth",
        "https://exon.exonproject.ru/auth/*",
        "https://exon.exonproject.ru/callback",
        "https://exon.exonproject.ru/callback/*"
      ],
      "js": [
        "snapshot.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": "",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://exon.exonproject.ru/*"
  ],
  "background": {
    "service_worker": "launcher.js"
  },
  "externally_connectable": {
    "matches": [
      "https://rakhmatullin.github.io/miskhub/*"
    ]
  }
}
